        { "path": "C:\\USERS\\BENPARKER\\REPO\\VENDOR\\x.ts", "refused": true, "why": "in another case" },
        { "path": "C:\\Users\\benparker\\repo\\VENDOR~1\\x.ts", "refused": true, "why": "the link by its short name" },
