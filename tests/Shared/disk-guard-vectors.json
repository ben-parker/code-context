        { "path": "\\\\TOOLS\\Node\\lib\\x.js", "refused": false, "why": "in any case" },
        { "path": "\\\\tools\\other\\x.js", "refused": true, "why": "another share of that host" },
        { "path": "C:\\Users\\benparker\\repo\\vendor\\lib\\x.ts", "refused": true, "why": "through a link to a share" },
        { "path": "C:\\Users\\benparker\\repo\\vendor", "refused": true, "why": "the link itself" },
