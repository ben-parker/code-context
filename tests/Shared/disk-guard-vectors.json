        { "path": "C:\\Users\\benparker::$INDEX_ALLOCATION\\repo\\vendor\\x.ts", "refused": true, "why": "by a stream of a directory above it" },
        { "path": "C:\\Users\\benparker\\repo\\src\\a.ts::$DATA", "refused": true, "why": "a stream of a plain file: nothing reads one" },
        { "path": "C:\\Users\\benparker\\repo.\\vendor\\x.ts", "refused": true, "why": "into the repository by a name Windows trims" },
        { "path": "C:\\Users\\benparker.\\repo\\vendor\\x.ts", "refused": true, "why": "by such a name above it" },
        { "path": "C:\\Users\\benparker.\\repo\\src\\a.ts", "refused": false, "why": "such a name above the repository is no fault" },
        { "path": "C:\\Users\\BENPAR~1\\repo\\src\\a.ts", "refused": false, "why": "a short name above the repository is no fault" },
        { "path": "C:\\Users\\benparker\\repo\\NODE_M~1\\left\\index.js", "refused": false, "why": "a short name of a plain directory" },
        { "path": "C:\\Users\\benparker\\repo\\a\\x.ts", "refused": true, "why": "a link to a link to a share" },
        { "path": "C:\\Users\\benparker\\repo\\loop1\\x.ts", "refused": true, "why": "links that lead to each other" },
        { "path": "C:\\Users\\benparker\\repo\\device\\x.ts", "refused": true, "why": "a link to a device path" },
        { "path": "C:\\Users\\benparker\\repo\\nt\\x.ts", "refused": true, "why": "a link whose text is in the system's own form" },
        { "path": "C:\\Users\\benparker\\repo\\back\\x.ts", "refused": true, "why": "a link that comes back in by a short name" },
        { "path": "C:\\Users\\benparker\\repo\\node_modules\\pkg\\index.d.ts", "refused": { "csharp": true, "typescript": false }, "why": "a package manager's link" },
        { "path": "C:\\Users\\benparker\\repo\\shared\\x.ts", "refused": { "csharp": true, "typescript": false }, "why": "a link to another drive" },
        { "path": "C:\\Users\\benparker\\repo\\relative\\x.ts", "refused": { "csharp": true, "typescript": false }, "why": "a link by a relative path" },
        { "path": "C:\\tools\\sdk\\ref\\System.Runtime.dll", "refused": false, "why": "a link outside the repository is the owner's" }
      ]
    },
    {
      "name": "a repository that is a whole drive",
      "root": "X:\\",
      "links": {
        "X:\\vendor": "\\\\evil\\share\\vendor"
      },
      "aliases": {},
      "cases": [
