      "allow": [
        "\\\\tools\\node\\bin\\node.exe"
      ],
      "links": {
        "C:\\Users\\benparker\\repo\\vendor": "\\\\evil\\share\\vendor",
        "C:\\Users\\benparker\\repo\\src\\leaf.ts": "\\\\evil\\share\\leaf.ts",
        "C:\\Users\\benparker\\repo\\node_modules\\pkg": "C:\\Users\\benparker\\repo\\node_modules\\.store\\pkg@1",
        "C:\\Users\\benparker\\repo\\shared": "D:\\elsewhere\\shared",
        "C:\\Users\\benparker\\repo\\relative": "..\\sibling",
        "C:\\Users\\benparker\\repo\\a": "C:\\Users\\benparker\\repo\\b",
        "C:\\Users\\benparker\\repo\\b": "\\\\evil\\share\\b",
        "C:\\Users\\benparker\\repo\\loop1": "C:\\Users\\benparker\\repo\\loop2",
        "C:\\Users\\benparker\\repo\\loop2": "C:\\Users\\benparker\\repo\\loop1",
        "C:\\Users\\benparker\\repo\\device": "\\\\?\\UNC\\evil\\share",
        "C:\\Users\\benparker\\repo\\nt": "\\??\\GLOBALROOT\\Device\\Mup\\evil\\share",
        "C:\\Users\\benparker\\repo\\back": "C:\\Users\\BENPAR~1\\repo\\vendor",
        "C:\\tools\\sdk": "\\\\owner\\share\\sdk"
      },
      "aliases": {
        "C:\\Users\\BENPAR~1": "C:\\Users\\benparker",
        "C:\\Users\\benparker\\repo\\VENDOR~1": "C:\\Users\\benparker\\repo\\vendor",
        "C:\\Users\\benparker\\repo\\vendor.": "C:\\Users\\benparker\\repo\\vendor",
        "C:\\Users\\benparker\\repo\\NODE_M~1": "C:\\Users\\benparker\\repo\\node_modules",
        "C:\\Users\\benparker\\repo.": "C:\\Users\\benparker\\repo",
        "C:\\Users\\benparker.": "C:\\Users\\benparker"
      },
      "cases": [
        { "path": "C:\\Users\\benparker\\repo\\src\\a.ts", "refused": false, "why": "a file in the repository" },
        { "path": "C:/Users/benparker/repo/src/a.ts", "refused": false, "why": "the other separator" },
        { "path": "C:\\Users\\benparker\\repo", "refused": false, "why": "the repository itself" },
        { "path": "C:\\Users\\benparker\\repo\\src\\missing.ts", "refused": false, "why": "a file that is not there is only missing" },
        { "path": "D:\\other\\project\\tsconfig.json", "refused": false, "why": "another drive" },
        { "path": "\\\\evil\\share\\x.json", "refused": true, "why": "a share nobody chose" },
        { "path": "//evil/share/x.json", "refused": true, "why": "the other separator" },
        { "path": "\\/evil/share/x.json", "refused": true, "why": "mixed separators" },
        { "path": "\\\\evil\\share", "refused": true, "why": "the share itself" },
        { "path": "\\\\evil\\share\\a\\..\\b", "refused": true, "why": "segments to fold" },
        { "path": "\\\\?\\UNC\\evil\\share\\x.json", "refused": true, "why": "a device path to a share" },
        { "path": "\\\\.\\UNC\\evil\\share\\x.json", "refused": true, "why": "the other device prefix" },
        { "path": "\\\\?\\C:\\Users\\benparker\\repo\\src\\a.ts", "refused": true, "why": "a device path is not taken at its word" },
        { "path": "\\\\evil@80\\share\\x.json", "refused": true, "why": "WebDAV by port" },
