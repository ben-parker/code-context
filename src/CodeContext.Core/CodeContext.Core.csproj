<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Snapshots/MappedRegion reads a read-only memory mapping through one bounds-checked slice. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- No Roslyn here: C# semantics live in CodeContext.CSharp.Worker behind the
         parser protocol. The host must never depend on a language toolchain. -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodeContext.Parser.Protocol\CodeContext.Parser.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The C# worker's rule for which paths may be touched, as source: the host applies it to the
         paths a worker reports (Paths/ReportedPaths.cs). The file uses nothing of the worker's, so
         this adds no dependency on it or on a language toolchain. -->
    <Compile Include="..\CodeContext.CSharp.Worker\Projects\PathGuard.cs" Link="Paths\PathGuard.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- GraphContractTests references ContextService's edge-kind sets directly so the
         producer/consumer contract is checked against the real consumed lists, not a
         hand-copied duplicate. -->
    <InternalsVisibleTo Include="CodeContext.Core.Tests" />
  </ItemGroup>
</Project>
